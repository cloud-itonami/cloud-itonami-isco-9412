(ns kitchen.actor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kitchen.actor :as actor]
            [kitchen.store :as store]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-client! st {:client-id "client-1" :name "Kobo Kitchens"})
    (store/register-kitchen! st {:kitchen-id "K-1" :client-id "client-1"
                                 :name "kitchen-042"
                                 :min-sanitize-temp-c 60
                                 :max-sanitize-temp-c 82
                                 :max-restock-quantity 200})
    st))

(deftest commits-an-in-band-under-ceiling-task
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-kitchen-task :stake :low
                 :kitchen-id "K-1" :sanitize-temp-c 70 :restock-quantity 100}
        result (actor/run-request! graph request {} "thread-1")]
    (is (= :done (:status result)))
    (is (some? (get-in result [:state :record])))
    (is (= 1 (count (store/records-of st "client-1"))))))

(deftest holds-an-out-of-band-sanitize-task
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-kitchen-task :stake :low
                 :kitchen-id "K-1" :sanitize-temp-c 40 :restock-quantity 100}
        result (actor/run-request! graph request {} "thread-2")]
    (is (= :hold (:disposition (:state result))))
    (is (empty? (store/records-of st "client-1")))))

(deftest interrupts-then-approves-sharp-tool-zone-entry-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-sharp-tool-zone-entry :stake :low
                 :kitchen-id "K-1"}
        interrupted (actor/run-request! graph request {} "thread-3")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "client-1")))
    (let [resumed (actor/approve! graph "thread-3")]
      (is (= :done (:status resumed)))
      (is (= 1 (count (store/records-of st "client-1")))))))
